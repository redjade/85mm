---
import { render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import DofCalc from '../../components/DofCalc.astro';
import FramesDiagram from '../../components/FramesDiagram.astro';
import { u, getLearn, getDrills, drillNo } from '../../lib/site';

export async function getStaticPaths() {
  const learn = await getLearn();
  return learn.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: learn[i - 1], next: learn[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const KIND_LABEL = { video: '영상', article: '글', book: '책', site: '사이트' } as const;
const sourceGroups = (['video', 'article', 'book', 'site'] as const)
  .map((k) => ({ label: KIND_LABEL[k], items: entry.data.sources.filter((s) => s.kind === k) }))
  .filter((g) => g.items.length);
const drills = (await getDrills()).filter((d) => d.data.read.some((r) => r.id === entry.id));
---

<Page title={entry.data.title} eyebrow={`배우기 ${String(entry.data.order).padStart(2, '0')}`} lede={entry.data.summary}>
  <ul class="tags top">{entry.data.elements.map((e) => <li class="tag el">{e}</li>)}</ul>
  {entry.data.widget === 'frames' && <FramesDiagram />}
  <Content />
  {entry.data.widget === 'dof' && <DofCalc />}
  {
    drills.length > 0 && (
      <>
        <h2>이어지는 연습</h2>
        <ul>
          {drills.map((d) => (
            <li>
              <a href={u(`/drills/${d.id}/`)}>
                {drillNo(d.data.no)} {d.data.title}
              </a>
              <span class="muted"> · {d.data.task}</span>
            </li>
          ))}
        </ul>
      </>
    )
  }
  {
    sourceGroups.length > 0 && (
      <>
        <h2>참고</h2>
        {sourceGroups.map((g) => (
          <>
            <h3 class="src-kind">{g.label}</h3>
            <ul class="small">
              {g.items.map((s) => (
                <li>
                  <a href={s.url} rel="noopener">{s.label}</a>
                </li>
              ))}
            </ul>
          </>
        ))}
      </>
    )
  }
  <nav slot="after" class="pager measure small">
    {prev ? <a href={u(`/learn/${prev.id}/`)}>← {prev.data.title}</a> : <span />}
    {next ? <a href={u(`/learn/${next.id}/`)}>{next.data.title} →</a> : <a href={u('/drills/')}>연습하러 가기 →</a>}
  </nav>
</Page>

<style>
  .top { margin-bottom: 1rem; }
  .src-kind { font-family: var(--sans); font-size: 1rem; color: var(--ink-soft); margin: 1.2rem 0 0.3rem; }
  .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
</style>
