---
import Page from '../../layouts/Page.astro';
import { u, getDrills, getPhotos, drillNo, DISTANCE_LABEL, STAGES, ALWAYS_STAGE } from '../../lib/site';
const drills = await getDrills();
const photos = await getPhotos();
const count = (id: string) => photos.filter((p) => p.data.drill?.id === id).length;
const stages = Object.keys(STAGES)
  .map(Number)
  .map((n) => ({ n, ...STAGES[n], drills: drills.filter((d) => d.data.stage === n) }))
  .filter((s) => s.drills.length);
---

<Page
  title="연습"
  eyebrow="제약이 있는 과제"
  lede="나갈 때 하나를 골라 들고 나간다. 1단계부터 차례로 해 나가되, 언제든 앞으로 돌아가도 좋다. 늘 하는 연습은 순서와 상관없이 되풀이한다."
>
  <div slot="after">
    {
      stages.map((s) => (
        <section class="stage">
          <header class="measure">
            <p class="eyebrow">{s.n === ALWAYS_STAGE ? '순서 없이' : `${s.n}단계`}</p>
            <h2>{s.title}</h2>
            <p class="muted">{s.desc}</p>
          </header>
          <div class="grid">
            {s.drills.map((d) => {
              const n = count(d.id);
              return (
                <a class="card" href={u(`/drills/${d.id}/`)}>
                  <span class="no">
                    {drillNo(d.data.no)} · {d.data.time}
                    {n > 0 && <span class="done"> · 사진 {n}장</span>}
                  </span>
                  <h3>{d.data.title}</h3>
                  <p>{d.data.task}</p>
                  <ul class="tags">
                    {d.data.distance.map((x) => <li class="tag">{DISTANCE_LABEL[x]}</li>)}
                    {d.data.elements.map((e) => <li class="tag el">{e}</li>)}
                  </ul>
                </a>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
</Page>

<style>
  .stage { margin-top: 3rem; }
  .stage header h2 { margin: 0 0 0.3rem; }
  .stage header p.muted { margin: 0 0 1.2rem; }
  .done { color: var(--ink-soft); font-weight: 400; }
</style>
